<% if new_record %>
  <%= turbo_stream.prepend "krudmin-#{model_class.model_name.element}-items-list" do %>
    <%= render_item_row(model) %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "item-model-#{model.id}" do %>
    <%= render_item_row(model) %>
  <% end %>
<% end %>

<turbo-stream action="modal" target="crudFormModal" event="hide"></turbo-stream>
<turbo-stream action="init_controls"></turbo-stream>

<%= turbo_stream.update "krudmin-modal-container" do %>
  <%= render partial: 'modal_show' %>
<% end %>

<turbo-stream action="modal" target="crudFormModal" event="show"></turbo-stream>
