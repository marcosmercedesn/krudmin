.card.dashboard-widget{class: widget.background_class}
  .card-header.d-flex.justify-content-between.align-items-center
    %div
      %h4.mb-0= widget.label
      - if widget.description.present?
        %small.text-muted= widget.description
    - if widget.resource_path.present?
      = link_to t("krudmin.dashboard.view_all"), widget.resource_path, class: "btn btn-sm btn-outline-primary"
  .list-group.list-group-flush
    - if widget.empty?
      .list-group-item.text-muted= t("krudmin.dashboard.empty")
    - else
      - widget.records.each do |record|
        .list-group-item
          .d-flex.justify-content-between.align-items-center.gap-3
            %div
              %strong.d-block= widget.label_for(record)
              - secondary_value = widget.secondary_value_for(record)
              - if secondary_value.present?
                %small.text-muted= secondary_value