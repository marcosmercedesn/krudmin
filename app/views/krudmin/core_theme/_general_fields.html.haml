- valid_editable_attributes = metadata.fetch(:attributes) & editable_attributes

- return if valid_editable_attributes.empty?

%div{class: metadata.fetch(:class, 'col-lg-6 col-md-12')}
  .card{data: {controller: "card-collapse", card_collapse_panel_value: key}}
    .card-header
      %h5.float-start
        = metadata.fetch(:label)
      .card-actions.float-end
        %a.btn.card-collapser{href: '#', data: {action: "click->card-collapse#toggle"}}
          %i.bi.bi-chevron-up.fa-lg{data: {card_collapse_target: "icon"}}
    .card-body{data: {card_collapse_target: "body"}}
      .row
        - valid_editable_attributes.each do |attribute|
          %div{class: metadata.fetch(:input_container_class, 'col-md-12')}
            = field_for(attribute, model).render(:form, self, {form: f})
