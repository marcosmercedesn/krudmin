%div{data: { controller: "belongs-to-one", belongs_to_one_model_id_value: field.model.send(attribute)&.id, belongs_to_one_form_fields_value: form_fields }}
  .form-fields{data: {belongs_to_one_target: "fields"}}
    - if display_fields_on_load
      = form_fields.html_safe
  - unless required
    = link_to("#", class: "btn btn-warning hidden", data: {action: "belongs-to-one#add", belongs_to_one_target: "addButton"}) do
      %i.bi.bi-plus
      = t('krudmin.actions.add_new')

    = link_to("#", class: "btn btn-danger hidden", data: {action: "belongs-to-one#remove", belongs_to_one_target: "removeButton"}) do
      %i.bi.bi-trash
      = t('krudmin.actions.delete')
