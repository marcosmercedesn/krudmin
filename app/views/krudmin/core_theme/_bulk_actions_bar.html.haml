.bulk-actions-bar.alert.alert-info.d-none{data: {bulk_actions_target: "bar"}}
  .d-flex.align-items-center.justify-content-between
    %span.bulk-actions-count
      %strong{data: {bulk_actions_target: "count"}} 0
      = t('krudmin.bulk_actions.items_selected')
    .bulk-actions-buttons
      - krudmin_manager.bulk_actions.each do |action|
        - case action
        - when :destroy
          %button.btn.btn-danger.btn-sm.ms-2{type: "button", data: {action: "bulk-actions#perform", url: url_for(action: :bulk_destroy), confirm: t('krudmin.bulk_actions.confirm_destroy'), confirm_icon: "warning"}}
            %i.fa.fa-trash
            = t('krudmin.actions.delete')
        - when :activate
          %button.btn.btn-success.btn-sm.ms-2{type: "button", data: {action: "bulk-actions#perform", url: url_for(action: :bulk_activate), confirm: t('krudmin.bulk_actions.confirm_activate'), confirm_icon: "info"}}
            %i.fa.fa-check
            = t('krudmin.actions.activate')
        - when :deactivate
          %button.btn.btn-warning.btn-sm.ms-2{type: "button", data: {action: "bulk-actions#perform", url: url_for(action: :bulk_deactivate), confirm: t('krudmin.bulk_actions.confirm_deactivate'), confirm_icon: "warning"}}
            %i.fa.fa-ban
            = t('krudmin.actions.deactivate')
