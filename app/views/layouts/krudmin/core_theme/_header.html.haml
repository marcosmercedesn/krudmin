%header.app-header.navbar
  %button.navbar-toggler.mobile-sidebar-toggler.d-lg-none.me-auto{type: "button", data: {action: "sidebar#toggleMobile"}}
    %span.navbar-toggler-icon
  %a.navbar-brand{href: krudmin_root_path}
  %button.navbar-toggler.sidebar-toggler.d-none.d-md-block{type: "button", data: {action: "sidebar#toggle"}}
    %span.navbar-toggler-icon
  %ul.nav.navbar-nav.d-none.d-md-block
    %li.nav-item.px-3
      %a.nav-link{href: krudmin_root_path}
        = t('krudmin.labels.dashboard')
  %ul.nav.navbar-nav.ms-auto#main-user-menu
    = render partial: '/layouts/krudmin/core_theme/top_user_menu'
