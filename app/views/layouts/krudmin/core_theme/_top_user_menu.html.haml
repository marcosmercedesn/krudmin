- if _current_user
  %li.nav-item.dropdown
    %a.nav-link.dropdown-toggle.nav-link{"aria-expanded" => "false", "aria-haspopup" => "true", "data-bs-toggle" => "dropdown", href: "#", role: "button"}
      %span.d-none.d-sm-inline
        = _current_user.name
      %span.d-sm-none
        %i.icon-people
    .dropdown-menu.dropdown-menu-end
      .dropdown-header.text-center
        %strong Settings
      = link_to(send(Krudmin::Config.edit_profile_path, _current_user), class: 'dropdown-item') do
        %i.bi.bi-person
        = I18n.t('krudmin.labels.edit_profile')
      = link_to(send(Krudmin::Config.logout_path), method: :delete, data: {no_turbolink: true}, class: 'dropdown-item') do
        %i.bi.bi-lock
        = I18n.t('krudmin.labels.logout')
