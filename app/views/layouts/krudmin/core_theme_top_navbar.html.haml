!!!
%html{lang: "en"}
  %head
    %meta{content: "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{charset: "utf-8"}/
    %meta{content: "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %meta{content: "width=device-width, initial-scale=1, shrink-to-fit=no", :name => "viewport"}/
    = csrf_meta_tag

    %title
      = content_for?(:page_title) ? yield(:page_title) : try(:crud_title)
    = stylesheet_link_tag    'krudmin/core_theme/application', media: 'all', 'data-turbo-track' => 'reload'
    = javascript_include_tag 'krudmin/core_theme/application', 'data-turbo-track' => 'reload'
    = stylesheet_link_tag    "https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css", crossorigin: "anonymous", referrerpolicy: "no-referrer"

    = render partial: 'layouts/krudmin/core_theme/head_content'

    = yield(:head_content)

  %body.app.header-fixed.sidebar-fixed.aside-menu-fixed.aside-menu-hidden.light-krudmin-theme{class: body_classes, data: {bs_theme: :light, controller: controller_name, action: action_name, model_id: model_id}}
    #body-overlay
    .app-body
      %main.main
        = render partial: 'layouts/krudmin/core_theme/top_menu_with_toolbar'

        #ui-view.container-fluid
          = render 'layouts/krudmin/core_theme/messages'

          = yield
      = render partial: '/layouts/krudmin/core_theme/aside_menu'
    #krudmin-modal-container
    %footer.app-footer
      %span
        = render 'layouts/krudmin/core_theme/copyright'
