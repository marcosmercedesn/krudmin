- configure_toolbar(:list, self) do |b|
  - b.button :new, nil, data: krudmin_manager.remote_crud ? { controller: "remote-modal", action: "click->remote-modal#open" } : {}
  - b.button :search
  - b.link admin_cars_path, class: 'btn btn-danger' do
    %i.bi.bi-car-front
  - b.link 'https://google.com', class: 'btn btn-primary', target: :_blank, data: { turbo_confirm: "Do you really wanna go there?", confirm_icon: :success, title: :Google, confirm_class: :success } do
    %i.bi.bi-google
    %i.bi.bi-plus
    Google
